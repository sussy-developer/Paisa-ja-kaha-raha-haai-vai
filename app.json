{
  "expo": {
    "name": "workplace",
    "slug": "workplace",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/FIcon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sussydeveloper.workplace"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0C",
        "foregroundImage": "./assets/FIcon.png",
        "monochromeImage": "./assets/FIcon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.sussydeveloper.workplace"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-video",
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "-keep class expo.modules.video.** { *; }\n-keep class androidx.media3.** { *; }"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "fb65c3ff-36d7-4c28-90f0-868ca954dd37"
      }
    },
    "owner": "sussy-developer"
  }
}
